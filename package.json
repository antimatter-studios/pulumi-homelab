{
  "name": "pulumi-homelab",
  "description": "Pulumi resources for a Linux machine you own: desired state over SSH, with real drift detection.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --experimental-strip-types scripts/serialise-check.ts",
    "test:unit": "vitest run",
    "check:serialise": "node --experimental-strip-types scripts/serialise-check.ts"
  },
  "dependencies": {
    "@pulumi/command": "^1.0.1",
    "@pulumi/pulumi": "^3.140.0",
    "@pulumi/kubernetes": "^4.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "version": "0.1.0",
  "license": "MIT",
  "main": "src/index.ts",
  "keywords": [
    "apt",
    "configuration-management",
    "flux",
    "homelab",
    "kubernetes",
    "linux",
    "pulumi",
    "ssh",
    "systemd"
  ]
}
