  {
    "name": "flux wiring with patch and provider",
    "helper": "fluxApp",
    "args": {
      "name": "app",
      "options": {
        "url": "https://github.com/example/app",
        "branch": "stage",
        "path": "./deploy",
        "namespace": "ops",
        "interval": "2m",
        "reconcileInterval": "10m",
        "prune": false,
        "include": [
          "deploy"
        ],
        "secretRef": "deploy-key"
      },
      "patch": "[{\"op\":\"add\",\"path\":\"/spec/priorityClassName\",\"value\":\"critical\"}]"
    }
  },
