  {
    "name": "claude backend and profile wiring",
    "helper": "claudeResources",
    "args": {
      "backend": {
        "account": "dev",
        "path": "/home/dev/.claude/"
      },
      "profile": {
        "account": "dev",
        "dir": "/home/dev/.claude-work",
        "group": "work",
        "mode": "0700"
      }
    }
  },
  {
    "name": "default t3code wiring",
    "helper": "t3codeResource",
    "args": {
      "options": {
        "home": "/srv/t3code",
        "workspace": "/srv/projects",
        "uid": 1100,
        "groups": [
          "kvm"
        ],
        "git": {
          "config": "[user]\n    name = Test\n"
        }
      },
      "groups": true
    }
  },
  {
    "name": "secondary t3code wiring",
    "helper": "t3codeResource",
    "args": {
      "options": {
        "account": "other",
        "home": "/srv/other",
        "workspace": "/work",
        "git": {
          "config": "",
          "keyComment": ""
        },
        "agents": [],
        "sudo": false,
        "unit": {
          "name": "t3-other",
          "limits": {
            "cpuWeight": 25
          }
        }
      }
    }
  },
