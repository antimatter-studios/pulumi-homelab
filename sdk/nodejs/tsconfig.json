{
    "compilerOptions": {
        "outDir": "bin",
        "target": "es2016",
        "module": "commonjs",
        "moduleResolution": "node",
        "declaration": true,
        "sourceMap": true,
        "stripInternal": true,
        "experimentalDecorators": true,
        "noFallthroughCasesInSwitch": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true
    },
    "files": [
        "authorizedKey.ts",
        "bootConfig.ts",
        "config/index.ts",
        "config/vars.ts",
        "fstabEntry.ts",
        "group.ts",
        "hostname.ts",
        "index.ts",
        "journald.ts",
        "kernelCmdline.ts",
        "managedLine.ts",
        "precondition.ts",
        "provider.ts",
        "sshKey.ts",
        "sshdConfig.ts",
        "sudoRule.ts",
        "swap.ts",
        "systemdInstance.ts",
        "systemdUnit.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "user.ts",
        "utilities.ts"
    ]
}
